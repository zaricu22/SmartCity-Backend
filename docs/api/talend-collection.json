  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"min8chars\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://smartcity-backend-9g09.onrender.com/SmartCityREST/v1/auth/register",
              "protocol": "https",
              "host": ["smartcity-backend-9g09", "onrender", "com"],
              "path": ["SmartCityREST", "v1", "auth", "register"]
            },
            "description": "Creates a new local account. All self-registered users receive the VIEWER role. Response: 201 Created — body contains token + refreshToken. Errors: 409 Conflict (email already registered)."
          },
          "response": []
        },
        {
          "name": "POST Register — 409 Duplicate Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"min8chars\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://smartcity-backend-9g09.onrender.com/SmartCityREST/v1/auth/register",
              "protocol": "https",
              "host": ["smartcity-backend-9g09", "onrender", "com"],
              "path": ["SmartCityREST", "v1", "auth", "register"]
            },
            "description": "Triggers 409 Conflict — send after a successful register to demonstrate duplicate email rejection."
          },
          "response": []
        },
        {
          "name": "POST Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{ADMIN_PASSWORD}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://smartcity-backend-9g09.onrender.com/SmartCityREST/v1/auth/login",
              "protocol": "https",
              "host": ["smartcity-backend-9g09", "onrender", "com"],
              "path": ["SmartCityREST", "v1", "auth", "login"]
            },
            "description": "Authenticate as the pre-seeded admin user. Response: 200 OK — { token, role: ADMIN, expiresInMs, refreshToken }. Errors: 401 Unauthorized (wrong credentials)."
          },
          "response": []
        },
        {
          "name": "POST Login (viewer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"viewer\",\n  \"password\": \"{{VIEWER_PASSWORD}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://smartcity-backend-9g09.onrender.com/SmartCityREST/v1/auth/login",
              "protocol": "https",
              "host": ["smartcity-backend-9g09", "onrender", "com"],
              "path": ["SmartCityREST", "v1", "auth", "login"]
            },
            "description": "Authenticate as the pre-seeded viewer user. Response: 200 OK — { token, role: VIEWER, expiresInMs, refreshToken }."
          },
          "response": []
        },
        {
          "name": "POST Login — 401 Bad Credentials",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrongpassword\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://smartcity-backend-9g09.onrender.com/SmartCityREST/v1/auth/login",
              "protocol": "https",
              "host": ["smartcity-backend-9g09", "onrender", "com"],
              "path": ["SmartCityREST", "v1", "auth", "login"]
            },
            "description": "Triggers 401 Unauthorized — wrong password."
          },
          "response": []
        },
        {
          "name": "POST Refresh",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://smartcity-backend-9g09.onrender.com/SmartCityREST/v1/auth/refresh",
              "protocol": "https",
              "host": ["smartcity-backend-9g09", "onrender", "com"],
              "path": ["SmartCityREST", "v1", "auth", "refresh"]
            },
            "description": "Exchange an unexpired refresh token for a new access token + new refresh token. The old refresh token is consumed (single-use). Response: 200 OK — same shape as login. Errors: 401 (token not found, already used, or expired)."
          },
          "response": []
        },
        {
          "name": "POST Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://smartcity-backend-9g09.onrender.com/SmartCityREST/v1/auth/logout",
              "protocol": "https",
              "host": ["smartcity-backend-9g09", "onrender", "com"],
              "path": ["SmartCityREST", "v1", "auth", "logout"]
            },
            "description": "Revokes the current access token (jti added to blacklist) and consumes the refresh token. Requires Authorization: Bearer header. Response: 204 No Content."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Buildings",
      "item": [
        {
          "name": "GET All Buildings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": {
              "raw": "https://smartcity-backend-9g09.onrender.com/SmartCityREST/v1/buildings",
              "protocol": "https",
              "host": ["smartcity-backend-9g09", "onrender", "com"],
              "path": ["SmartCityREST", "v1", "buildings"]
            },
            "description": "Returns all public buildings (paginated). Optional ?name= and ?location= query params filter by case-insensitive partial match, combined with AND (not applied when eligible=true). Response: 200 OK — array of building objects. Requires VIEWER or ADMIN role."
          },
          "response": []
        },
        {
          "name": "GET Building by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": {
              "raw": "https://smartcity-backend-9g09.onrender.com/SmartCityREST/v1/buildings/00000000-0000-0000-0000-000000000001",
              "protocol": "https",
              "host": ["smartcity-backend-9g09", "onrender", "com"],
              "path": ["SmartCityREST", "v1", "buildings", "00000000-0000-0000-0000-000000000001"]
            },
            "description": "Returns a single building by UUID. Replace the last path segment with a real building ID. Response: 200 OK | 404 Not Found. Requires VIEWER or ADMIN role."
          },
          "response": []
        },
        {
          "name": "POST Create Building",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"City Hall\",\n  \"location\": \"Main Square 1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://smartcity-backend-9g09.onrender.com/SmartCityREST/v1/buildings",
              "protocol": "https",
              "host": ["smartcity-backend-9g09", "onrender", "com"],
              "path": ["SmartCityREST", "v1", "buildings"]
            },
            "description": "Creates a new public building. Response: 201 Created — body contains UUID; Location header points to new resource. Errors: 400 | 409 (duplicate name+location) | 422. Requires ADMIN role."
          },
          "response": []
        },
        {
          "name": "POST Create Building — 400 Validation Error",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"location\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://smartcity-backend-9g09.onrender.com/SmartCityREST/v1/buildings",
              "protocol": "https",
              "host": ["smartcity-backend-9g09", "onrender", "com"],
              "path": ["SmartCityREST", "v1", "buildings"]
            },
            "description": "Triggers 400 Bad Request — blank fields fail @NotBlank validation. Requires ADMIN role."
          },
          "response": []
        }
      ]
    },
